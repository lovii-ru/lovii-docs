+it('counts the awaiting limit per submitting user and blocks a reopen over the cap', function (): void {
+    bindDadata(fakeParty());
+    $user = User::factory()->create();
+    $other = User::factory()->create();
+
+    $point = fn (string $name, float $lat): array => applicationPayload([
+        'name' => $name,
+        'address_line' => 'Санкт-Петербург, '.$name,
+        'lat' => $lat,
+        'lon' => 30.35,
+    ]);
+
+    // Пять заявок на подтверждении — предел владельца.
+    foreach (range(1, 5) as $index) {
+        $this->actingAs($user)
+            ->postJson('/api/v1/business/applications', $point('Точка '.$index, 59.80 + $index / 100))
+            ->assertCreated();
+    }
+
+    // Шестая у того же пользователя — сверх лимита.
+    $this->actingAs($user)
+        ->postJson('/api/v1/business/applications', $point('Шестая точка', 60.10))
+        ->assertStatus(422)
+        ->assertJsonPath('error.code', 'partner_application_cap_reached');
+
+    // Лимит персональный: заявки другого пользователя в него не входят.
+    $this->actingAs($other)
+        ->postJson('/api/v1/business/applications', $point('Чужая точка', 60.20))
+        ->assertCreated();
+
+    // Отказ — отмена: заявка уходит со счёта, слот освобождается.
+    $victim = PartnerApplication::query()->where('user_id', $user->id)->orderBy('id')->firstOrFail();
+    $representative = User::factory()->create();
+    $victim->forceFill([
+        'status' => PartnerApplicationStatus::AwaitingRepApproval,
+        'representative_user_id' => $representative->id,
+    ])->save();
+    resolve(RejectPartnerApplicationAction::class)->execute($representative, $victim, 'не то');
+
+    // Освободившийся слот занимает новая точка.
+    $this->actingAs($user)
+        ->postJson('/api/v1/business/applications', $point('Заняли слот', 60.30))
+        ->assertCreated();
+
+    // А переоткрытие отклонённой заявки теперь само упирается в лимит.
+    $this->actingAs($user)
+        ->postJson('/api/v1/business/applications', $point('Точка 1', 59.81))
+        ->assertStatus(422);
+
+    // Пять заявок ждут подтверждения — предел соблюдён, шестая не завелась.
+    expect(PartnerApplication::query()
+        ->where('user_id', $user->id)
+        ->whereIn('status', PartnerApplicationStatus::awaitingConfirmationValues())
+        ->count())->toBe(5);
+});
