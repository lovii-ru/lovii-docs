+
+    resolve(RejectPartnerApplicationAction::class)->execute($representative, $application, 'адрес не тот');
+
+    $application->refresh();
+    expect($application->status)->toBe(PartnerApplicationStatus::Failed);
+
+    $second = $this->actingAs($user)
+        ->postJson('/api/v1/business/applications', applicationPayload())
+        ->assertOk();
