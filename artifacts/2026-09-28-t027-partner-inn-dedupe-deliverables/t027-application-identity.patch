@@ -0,0 +1,100 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Domain\Business\Support;
+
+use App\Domain\Geo\Services\CityNameNormalizer;
+
+/**
+ * Ключ идентичности заявки «ЛОВИ Бизнес».
+ *
+ * Решение владельца (2026-09-27): одна точка или одно МСП — это одна заявка.
+ * Отказ — не повод завести вторую заявку на ту же точку, а её состояние;
+ * повторная подача правит прежнюю запись. Без ключа каждая повторная подача
+ * создавала нового партнёра-черновика и съедала слот лимита (доходило до
+ * блокировки владельца пятью отказами по одной и той же точке).
+ *
+ * Ключ = нормализованный ИНН + место точки:
+ *  - координаты (обычный путь мобильного клиента) — сетка ~11 м;
+ *  - координат нет, но есть адрес — город + нормализованный адрес;
+ *  - адресуемой точки нет — МСП-ключ, только ИНН.
+ *
+ * Почему не по одному ИНН: у одного юрлица бывает несколько точек по разным
+ * адресам (подтверждено стендом — под одним ИНН три разных адреса). Склейка
+ * по ИНН их бы уничтожила.
+ */
+final class PartnerApplicationIdentity
+{
+    /** Заявка без адресуемой точки: идентичность держится на ИНН. */
+    public const string NO_POINT = 'no-point';
+
+    /** Ключ заявки: sha256 от «ИНН | место». */
+    public static function forApplication(
+        string $inn,
+        mixed $lat,
+        mixed $lon,
+        ?string $cityName,
+        ?string $addressLine,
+    ): string {
+        return hash('sha256', self::innKey($inn).'|'.self::placeKey($lat, $lon, $cityName, $addressLine));
+    }
+
+    /** ИНН без разделителей — та же нормализация, что и в экшене создания. */
+    public static function innKey(string $inn): string
+    {
+        return (string) preg_replace('/\D+/', '', $inn);
+    }
+
+    /** Ключ места: координаты старше адреса, адрес старше «нет точки». */
+    public static function placeKey(mixed $lat, mixed $lon, ?string $cityName, ?string $addressLine): string
+    {
+        if (is_numeric($lat) && is_numeric($lon)) {
+            return 'geo:'.number_format((float) $lat, 4, '.', '').','.number_format((float) $lon, 4, '.', '');
+        }
+
+        $address = self::normalizeAddress($addressLine);
+
+        if ($address === '') {
+            return self::NO_POINT;
+        }
+
+        $city = $cityName !== null && mb_trim($cityName) !== ''
+            ? CityNameNormalizer::key($cityName)
+            : '—';
+
+        return 'addr:'.$city.'|'.$address;
+    }
+
+    /**
+     * Детерминированная нормализация адреса: регистр, ё→е, пунктуация и
+     * типовые слова («город», «улица», «дом», «корпус», «Россия») уходят,
+     * пробелы схлопываются. Одинаковая точка, записанная по-разному
+     * («ул. Белы Куна, 4к1» и «Белы Куна 4 к 1»), даёт один ключ.
+     */
+    public static function normalizeAddress(?string $address): string
+    {
+        if ($address === null) {
+            return '';
+        }
+
+        $value = mb_strtolower(mb_trim($address));
+
+        $value = str_replace(
+            ['ё', '«', '»', '"', "'", '№', '.', ',', ';', '(', ')'],
+            ['е', '', '', '', '', '', ' ', ' ', ' ', ' ', ' '],
+            $value,
+        );
+
+        $value = (string) preg_replace(
+            '/\b(россия|рф|город|г|улица|ул|дом|д|корпус|корп|к|строение|стр|офис|помещение|пом|этаж|литера)\b/u',
+            ' ',
+            $value,
+        );
+
+        $value = (string) preg_replace('/[^0-9a-zа-я\s\/-]+/u', ' ', $value);
+        $value = (string) preg_replace('/\s+/u', ' ', $value);
+
+        return mb_trim($value);
+    }
+}
