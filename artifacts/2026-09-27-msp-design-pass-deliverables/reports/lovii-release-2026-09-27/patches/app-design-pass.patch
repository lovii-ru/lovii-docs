diff --git a/src/modules/roles-module/money.ts b/src/modules/roles-module/money.ts
index 6bc203b..4a3a660 100644
--- a/src/modules/roles-module/money.ts
+++ b/src/modules/roles-module/money.ts
@@ -33,3 +33,29 @@ export function formatDateRu(iso: string | null): string {
 
 	return date.toLocaleDateString("ru-RU", { day: "numeric", month: "long", year: "numeric" });
 }
+
+/** Дата и время: «27 сентября, 16:25» — канон карточки апрува (как в демо). */
+export function formatDateTimeRu(iso: string | null): string {
+	if (!iso) return "";
+	const d = new Date(iso);
+	if (Number.isNaN(d.getTime())) return "";
+	const date = d.toLocaleDateString("ru-RU", { day: "numeric", month: "long" });
+	const time = d.toLocaleTimeString("ru-RU", { hour: "2-digit", minute: "2-digit" });
+	return `${date}, ${time}`;
+}
+
+/** Телефон в читаемой маске: «+7 000 000-00-01» (E.164 → маска). */
+export function formatPhoneRu(raw: string | null): string {
+	if (!raw) return "";
+	const digits = raw.replace(/\D/g, "");
+	if (digits.length === 11) {
+		return `+${digits[0]} ${digits.slice(1, 4)} ${digits.slice(4, 7)}-${digits.slice(7, 9)}-${digits.slice(9, 11)}`;
+	}
+	return raw;
+}
+
+/** Типографика набора: прямые кавычки в названиях → «ёлочки» (канон). */
+export function typoRu(value: string | null): string {
+	if (!value) return "";
+	return value.replace(/"([^"]+)"/g, "«$1»");
+}
